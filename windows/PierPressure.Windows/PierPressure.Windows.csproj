<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>PierPressure.Windows</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <WindowsPackageType>None</WindowsPackageType>
    <ApplicationTitle>Pier Pressure</ApplicationTitle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="3.116.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Game art: copy the 9 sprite PNGs + delta_ragtime.mp3 from the iOS
         project (ProjectDelta/Sprites/ and ProjectDelta/Resources/) into
         Resources\Raw\ here. They are MauiAssets, loaded at runtime. -->
    <MauiAsset Include="Resources\Raw\*" />
  </ItemGroup>

</Project>
