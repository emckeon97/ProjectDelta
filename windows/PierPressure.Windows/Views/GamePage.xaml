<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="PierPressure.Windows.Views.GamePage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="Black">
    <Grid>
        <skia:SKCanvasView x:Name="Canvas"
                          PaintSurface="OnPaintSurface"
                          EnableTouchEvents="True"
                          Touch="OnTouch" />

        <!-- Reel title card -->
        <Frame x:Name="ReelCard" IsVisible="False"
               BackgroundColor="#0A0A0C" BorderColor="#D4A942"
               CornerRadius="8" Padding="28,20"
               HorizontalOptions="Center" VerticalOptions="Center"
               HasShadow="False">
            <VerticalStackLayout Spacing="8">
                <Label x:Name="ReelTitle" FontSize="26" FontAttributes="Bold"
                       FontFamily="Georgia" TextColor="#F5EFE0"
                       HorizontalTextAlignment="Center" />
                <Label x:Name="ReelBlurb" FontSize="14" FontFamily="Georgia"
                       TextColor="#F5EFE0" Opacity="0.85"
                       HorizontalTextAlignment="Center"
                       MaximumWidthRequest="420" />
            </VerticalStackLayout>
        </Frame>

        <!-- HUD -->
        <VerticalStackLayout HorizontalOptions="Start" VerticalOptions="Start"
                             Margin="16,16,0,0" Spacing="2">
            <Label x:Name="ScoreLabel" FontSize="34" FontAttributes="Bold"
                   FontFamily="Georgia" TextColor="#F5EFE0" />
            <Label x:Name="CoinLabel" FontSize="16" FontAttributes="Bold"
                   FontFamily="Georgia" TextColor="#D4A942" />
        </VerticalStackLayout>

        <Button x:Name="PauseButton" Text="⏸" Clicked="OnPauseClicked"
                FontSize="20" BackgroundColor="#0F0F12" CornerRadius="12"
                WidthRequest="48" HeightRequest="48"
                HorizontalOptions="End" VerticalOptions="Start"
                Margin="0,16,16,0" />
    </Grid>
</ContentPage>
