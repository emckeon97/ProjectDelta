<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PierPressure.Windows.Views.GameOverPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#0A0A0C">
    <Grid>
        <VerticalStackLayout VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Padding="28" Spacing="0"
                             MaximumWidthRequest="480">

            <HorizontalStackLayout x:Name="LightsRow" Spacing="9"
                                   HorizontalOptions="Center"
                                   Margin="0,0,0,12" />

            <Label Text="THE END"
                   FontSize="40" FontAttributes="Bold" FontFamily="Georgia"
                   TextColor="#F5EFE0" HorizontalTextAlignment="Center" />

            <Label x:Name="RecordLabel" Text="★ NEW RECORD! ★"
                   FontSize="15" FontAttributes="Bold" FontFamily="Georgia"
                   TextColor="#D4A942" HorizontalTextAlignment="Center"
                   Margin="0,8,0,0" IsVisible="False" />

            <Label Text="DISTANCE"
                   FontSize="13" FontAttributes="Bold" FontFamily="Georgia"
                   TextColor="#F5EFE0" Opacity="0.6"
                   HorizontalTextAlignment="Center" Margin="0,18,0,0" />

            <Label x:Name="ScoreLabel"
                   FontSize="64" FontAttributes="Bold" FontFamily="Georgia"
                   TextColor="#D4A942" HorizontalTextAlignment="Center" />

            <Label x:Name="CoinLine"
                   FontSize="17" FontAttributes="Bold" FontFamily="Georgia"
                   TextColor="#F5EFE0" Opacity="0.75"
                   HorizontalTextAlignment="Center" Margin="0,4,0,0" />

            <Label x:Name="BestLine"
                   FontSize="17" FontAttributes="Bold" FontFamily="Georgia"
                   TextColor="#F5EFE0" Opacity="0.75"
                   HorizontalTextAlignment="Center" Margin="0,4,0,0" />

            <Button Text="RUN AGAIN" Clicked="OnRetryClicked"
                    BackgroundColor="#D4A942" TextColor="#0A0A0C"
                    FontSize="22" FontAttributes="Bold" FontFamily="Georgia"
                    CornerRadius="10" Padding="0,14" Margin="0,24,0,0" />

            <Button Text="LOBBY" Clicked="OnMenuClicked"
                    BackgroundColor="Transparent" TextColor="#F5EFE0"
                    BorderColor="#F5EFE0" BorderWidth="2"
                    FontSize="18" FontAttributes="Bold" FontFamily="Georgia"
                    CornerRadius="10" Padding="0,12" Margin="0,10,0,0" />

        </VerticalStackLayout>
    </Grid>
</ContentPage>
